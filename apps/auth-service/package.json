{
  "name": "@dexatrack/auth-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "bootstrap": "ts-node src/cli.ts bootstrap",
    "reconcile": "ts-node src/cli.ts reconcile",
